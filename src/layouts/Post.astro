---
import Content from "../components/Content.astro";
import BaseLayout from "./BaseLayout.astro";
import { SITE_TITLE } from "../consts";

export interface Props {
  content: {
    type: string;
    title: string;
    description: string;
    createdAt?: string;
    updatedAt?: string;
    heroImage?: string;
    tags: string[];
  };
}

const {
  content: { type, title, description, heroImage },
} = Astro.props;
---

<BaseLayout
  title={`${SITE_TITLE} / ${title}`}
  description={description}
  image={heroImage}
>
  <article class="post">
    {
      heroImage && (
        <img
          class="post-image"
          width={720}
          height={360}
          src={heroImage}
          alt=""
        />
      )
    }

    <header class="post-header">
      <p class="post-type">{type}</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>

    <Content className="post-content">
      <div class="markdown-body">
        <slot />
      </div>
    </Content>
  </article>
</BaseLayout>

<style>
  .post-image {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 1rem;
    object-fit: cover;
  }

  .post-header {
    margin: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 1.5rem;
  }

  .post-type {
    margin: 0;
    color: #a78bfa;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.75rem 0 0;
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1;
  }

  .post-header > p:last-child {
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    line-height: 1.65;
  }
</style>