---
import { searchIndex } from "../utils/searchIndex";
---

<script define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
</script>

<div class="relative w-64">
  <input
    id="search"
    type="text"
    placeholder="Search..."
    spellcheck="false"
    autocomplete="off"
    class="px-4 py-2 w-full rounded-full bg-violet-400/10
           backdrop-blur border border-violet-400/30
           focus:outline-none focus:ring-2 focus:ring-violet-400/50 text-sm"
  />

<div
  id="results"
  class="search-scroll absolute z-50 mt-2 w-full rounded-xl
         bg-black/60 backdrop-blur-md
         border border-violet-400/20
         shadow-lg shadow-black/30
         hidden max-h-72 overflow-y-auto"
>
</div>
</div>

<script is:inline>
  let debounceTimer;

  function debounceSearch(fn, delay = 3500) {
    return (...args) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => fn(...args), delay);
    };
  }

  const input = document.getElementById("search");
  const resultsEl = document.getElementById("results");

  const runSearch = (keyword) => {
    if (!keyword) {
      resultsEl.classList.add("hidden");
      resultsEl.innerHTML = "";
      return;
    }

    const results =
      window.__SEARCH_INDEX__?.filter((item) => {
        const title = item.title?.toLowerCase() ?? "";
        const desc = item.description?.toLowerCase() ?? "";
        const content = item.content?.toLowerCase() ?? "";

        return (
          title.includes(keyword) ||
          desc.includes(keyword) ||
          content.includes(keyword)
        );
      }) ?? [];

    resultsEl.classList.remove("hidden");

    if (results.length === 0) {
      resultsEl.innerHTML = `
        <div class="px-4 py-3 text-sm text-white/50">
          No results found
        </div>
      `;
      return;
    }

    resultsEl.innerHTML = results
      .slice(0, 5)
      .map(
        (r) => `
    <a href="${r.slug}"
       class="group block px-4 py-3 transition
              hover:bg-violet-400/10
              first:rounded-t-xl last:rounded-b-xl">

      <div class="text-sm font-medium text-white group-hover:text-violet-300">
        ${highlight(r.title, keyword)}
      </div>

      ${
        r.content
          ? `<div class="text-xs text-white/60 mt-0.5">
        ${highlightSnippet(r.content, keyword)}
      </div>`
          : ""
      }
    </a>
  `
      )
      .join("");
  };

  const debouncedSearch = debounceSearch(runSearch, 350);

  input.addEventListener("input", (e) => {
    debouncedSearch(e.target.value.toLowerCase());
  });

  // Hide results when clicking outside
  document.addEventListener("click", (e) => {
    if (!e.target.closest("#search") && !e.target.closest("#results")) {
      resultsEl.classList.add("hidden");
    }
  });
  // End hide results when clicking outside

  // Highlight function
  function highlight(text = "", keyword = "") {
    if (!keyword) return text;

    const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const regex = new RegExp(`(${escaped})`, "gi");

    return text.replace(
      regex,
      `<mark class="bg-violet-400/30 text-violet-200 rounded px-0.5">$1</mark>`
    );
  }
  // End highlight function

  function highlightSnippet(text = "", keyword = "", radius = 40) {
  if (!keyword) return text.slice(0, 80);

  const lowerText = text.toLowerCase();
  const lowerKeyword = keyword.toLowerCase();
  const index = lowerText.indexOf(lowerKeyword);

  if (index === -1) {
    return text.slice(0, 80) + "ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦";
  }

  const start = Math.max(0, index - radius);
  const end = Math.min(text.length, index + keyword.length + radius);

  let snippet = text.slice(start, end);

  if (start > 0) snippet = "ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦" + snippet;
  if (end < text.length) snippet = snippet + "ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦";

  return highlight(snippet, keyword);
}

</script>
