---
import { SITE_TITLE, SOCIAL_LINKS } from "../consts";
import { IoLogoGithub } from "react-icons/io5/index.js";
import HeaderLink from "./HeaderLink.astro";
import FootprintIcon from "./icons/Footprint";
// import ThemeToggle from "./ThemeToggleButton";
// import DropdownMenu from "./DropdownMenu";
---

<header class="fixed inset-x-0 top-0 z-20 border-b border-white/30 bg-white/40 px-4 py-3 backdrop-blur-xl dark:border-zinc-800/70 dark:bg-zinc-950/40 sm:px-6 lg:px-8">
  <div class="mx-auto flex max-w-6xl items-center justify-between">
    <a href="/" class="group flex items-center gap-3 rounded-full px-2 py-1 transition-transform duration-200 hover:-translate-y-0.5">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-purple-600/10 text-purple-700 shadow-sm ring-1 ring-purple-500/20 dark:bg-purple-500/15 dark:text-purple-200">
        <FootprintIcon />
      </span>
      <div class="leading-tight">
        <h2 class="font-patrickHand text-lg font-semibold tracking-wide text-zinc-900 transition-colors group-hover:text-orange-500 dark:text-zinc-100">
          {SITE_TITLE}
        </h2>
        <p class="text-[11px] uppercase tracking-[0.28em] text-zinc-500 dark:text-zinc-400">
          Building & documenting
        </p>
      </div>
    </a>

    <div class="flex items-center gap-3">
      <div class="hidden items-center gap-2 md:flex">
        <HeaderLink
          href={SOCIAL_LINKS.find((link) => link.key === "github")?.url}
          target="_blank"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-zinc-300/70 bg-white/70 text-zinc-700 transition-all hover:border-orange-400 hover:bg-orange-50 hover:text-orange-600 dark:border-zinc-700 dark:bg-zinc-900/70 dark:text-zinc-200 dark:hover:border-orange-400 dark:hover:bg-orange-500/10"
        >
          <IoLogoGithub size={20} />
        </HeaderLink>
      </div>
      <!-- <ThemeToggle client:visible />
      <DropdownMenu client:visible /> -->
    </div>
  </div>
</header>
