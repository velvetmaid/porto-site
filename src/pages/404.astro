---
import BaseHead from "../components/BaseHead.astro";
import Body from "../components/Body.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="404 Not Found" description="Oops, page not found" />
  </head>
  <Body>
    <div class="font-sans text-center space-y-4 text-sm md:text-base">
      <h1 class="text-9xl md:text-[12rem] drop-shadow-lg">
        <span class="font-black text-violet-400">404</span>
      </h1>
      <p class="text-2xl opacity-80">
        <span class="font-black text-violet-400">Oops, page not found</span>
      </p>
      <a
        href="/"
        class="mt-8 inline-block px-8 py-2 rounded-md font-bold bg-violet-400/30"
      >
        <span class="font-black">BACK</span>
      </a>
    </div>
  </Body>
</html>
